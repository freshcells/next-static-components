{
  "compilerOptions": {
    "outDir": "./dist/module",
    "declaration": true,
    "target": "ESNext",
    "module": "NodeNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "noEmit": true
  },
  "typeRoots": [],
  "include": ["./src/**/*.ts", "./src/**/*.tsx", "./test/e2e/**/*.ts", "./test/e2e/**/*.tsx"]
}
